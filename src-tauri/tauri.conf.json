{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OHJingJing",
  "version": "0.1.21",
  "identifier": "app.ohjingjing.desktop",
  "build": {
    "beforeDevCommand": "npm run build:runtime && npm run dev:web",
    "beforeBuildCommand": "npm run build:runtime && npm run build:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "OHJingJing", "width": 1050, "height": 750, "minWidth": 640, "minHeight": 520 }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["runtime/node"],
    "resources": {
      "runtime/runtime.mjs": "runtime.mjs",
      "runtime/dsh-text-turn.mjs": "dsh-text-turn.mjs",
      "../pi-workspace/node_modules": "pi-cli/node_modules",
      "../pi-workspace/LICENSE": "pi-cli/LICENSE"
    },
    "icon": ["icons/icon.ico"]
  }
}
